# --- Base de données ---
MONGODB_URI=mongodb://127.0.0.1:27017/accessoires_plus

# --- Authentification ---
# Générer avec: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Accessoires Plus
