# --- Base de données ---
MONGODB_URI=mongodb://127.0.0.1:27017/accessoires_plus

# --- Authentification ---
# Générer avec: openssl rand -base64 48
JWT_SECRET=change-me-with-a-long-random-string-at-least-32-chars

# --- Stockage des photos/vidéos (production Vercel uniquement) ---
# Créé automatiquement par Vercel quand on relie un store Blob au projet. NE PAS le mettre dans .env.local :
# sans lui, le site local enregistre les fichiers dans public/uploads.
# BLOB_READ_WRITE_TOKEN=

# --- Site ---
# URL publique EXACTE du site en production (https, sans « / » final) : utilisée pour canoniques, sitemap et données structurées
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Accessoires Plus
NEXT_PUBLIC_CURRENCY=DT

# --- Boutique ---
SHIPPING_FLAT_FEE=7
FREE_SHIPPING_THRESHOLD=150

# --- Anti-abus inscription (max comptes par IP / 24h) ---
MAX_SIGNUPS_PER_IP_PER_DAY=3

# --- Création du premier admin (scripts/create-admin.ts) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Str0ng-Password!
ADMIN_NAME=Administrateur
