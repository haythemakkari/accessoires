# Copier en .env.migrate (ignoré par git), remplir, puis : npm run migrate:prod
# Chaîne de connexion MongoDB Atlas (Atlas → Connect → Drivers), avec le nom de base à la fin :
TARGET_MONGODB_URI=mongodb+srv://USER:MOTDEPASSE@cluster0.xxxxx.mongodb.net/accessoires_plus?retryWrites=true&w=majority
# Vercel → Storage → votre store Blob → .env.local → BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=
